# ========================================================
# WEATHER DATA ANALYSIS SYSTEM - ENVIRONMENT VARIABLES
# ========================================================

# --- Frontend Configuration (React / Vite) ---
# When running locally, Vite proxies /api to Flask on port 5000.
# For remote or separate frontend deployment (e.g. Vercel), set this to your Render backend URL:
# Example: VITE_API_BASE_URL="https://weather-data-analysis-api.onrender.com/api"
VITE_API_BASE_URL="/api"

# --- Backend Server Configuration (Flask) ---
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS="*"

# --- MySQL Database Configuration ---
# Configure your local or cloud MySQL database credentials below.
# If omitted or offline, the system operates seamlessly in Standalone CSV Demonstration Mode.
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="weather_analytics_db"

# --- AI Studio / Cloud Run Injected Variables ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
